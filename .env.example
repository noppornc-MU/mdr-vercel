# Copy to a local .env (never commit it). Placeholders only — put real values in your local .env
# or, on Vercel, in Settings → Environment Variables (mark secrets "Sensitive"). See SECURITY.md.

# Database: PostgreSQL (required). Names match what Neon's Vercel integration injects.
#   DATABASE_URL          — runtime connection (Neon: pooled, host contains -pooler)
#   DATABASE_URL_UNPOOLED — direct connection used by `prisma migrate`
# Local Docker Postgres (see README / instruction.md): use the same URL for both, with the password you
# gave the container. Neon: keep `sslmode=require` in both URLs.
DATABASE_URL=postgresql://postgres:<password>@127.0.0.1:54329/mdr
DATABASE_URL_UNPOOLED=postgresql://postgres:<password>@127.0.0.1:54329/mdr

# Site access gate (HTTP Basic Auth in proxy.ts). Off locally when both are empty.
# On Vercel both are REQUIRED (otherwise every request gets 503); password ≥ 12 characters, random.
SITE_ACCESS_USER=
SITE_ACCESS_PASSWORD=

# Optional: where uploaded reports are stored (default ./uploads locally, os.tmpdir() on Vercel)
# UPLOAD_DIR=

# LLM provider: gemini | anthropic | bedrock
LLM_PROVIDER=gemini
# API key for the chosen provider (leave empty for cached mode)
LLM_API_KEY=
# Model name available to your account (check provider docs when setting up)
LLM_MODEL=

# For bedrock: standard AWS credentials/region env vars are used
AWS_REGION=

# live | cached  (cached = no network, uses fixtures/). Keep cached on Vercel.
EXTRACT_MODE=cached
AI_MODE=cached
